# Dependencies and build output - all regenerated by `npm install` and gradle
node_modules/
**/build/
.gradle/
**/.cxx/
*.hprof

# Machine-specific: this is the file whose backslash escaping broke the first build.
# Each developer generates their own.
local.properties

# Signing material must never be committed
*.keystore
*.jks

# The demo APK is ~59 MB. GitHub warns above 50 MB and a binary that changes every
# build bloats history permanently - attach it to a Release instead.
MdbRnDemo-*.apk

# Metro / RN caches
.metro-health-check*
*.tsbuildinfo

# OS noise
.DS_Store
Thumbs.db
